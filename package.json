{
  "name": "tas-widgets",
  "productName": "TAS Widget",
  "version": "0.1.0",
  "description": "TAS Widget — desktop widgets for Windows: music, system, weather, equalizer, plumbob",
  "main": "./out/main/index.js",
  "author": "TheAndrSon",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
